{
  "name": "summer-bodies-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "vite",
    "build": "node scripts/fetch-branding.mjs",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "test": "node --test \"src/**/*.test.js\"",
    "prettier-check": "prettier --check \"src/**/*.{js,vue}\" \"scripts/**/*.mjs\"",
    "prettier-fix": "prettier --write \"src/**/*.{js,vue}\" \"scripts/**/*.mjs\"",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "drand-client": "1.4.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
