{
  "name": "summer-bodies-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "vite",
    "build": "node scripts/fetch-branding.mjs",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "prettier-check": "prettier --check \"src/**/*.{js,vue}\" \"scripts/**/*.mjs\"",
    "prettier-fix": "prettier --write \"src/**/*.{js,vue}\" \"scripts/**/*.mjs\"",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.1"
  }
}
